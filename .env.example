# Copier ce fichier en `.env` avant de lancer `npm start` en local.
# (En Docker, ces valeurs sont fournies par docker-compose.yml.)

PORT=3000
GTFS_STATIC_URL=https://data.montpellier3m.fr/GTFS/Urbain/GTFS.zip
GTFS_REALTIME_URL=https://data.montpellier3m.fr/GTFS/Urbain/VehiclePosition.pb
GTFS_TRIPUPDATE_URL=https://data.montpellier3m.fr/GTFS/Urbain/TripUpdate.pb
SQLITE_PATH=data/gtfs.db
# Le fichier TAM est régénéré ~toutes les 30 s ; on interroge les positions plus souvent (15 s)
# avec des requêtes conditionnelles (If-Modified-Since) pour récupérer chaque version au plus tôt.
UPDATE_INTERVAL_MS=15000
# Horaires temps réel (TripUpdate.pb) : fichier plus gros, le serveur TAM renvoie 429 en dessous.
TRIPUPDATE_INTERVAL_MS=30000
# Réimporte le GTFS statique seulement si la base locale est plus vieille que X heures.
GTFS_MAX_AGE_HOURS=24
# Intervalle du réimport GTFS en tâche de fond pendant que le serveur tourne (défaut : 24 h).
# GTFS_REIMPORT_INTERVAL_MS=86400000
# Origines autorisées (CORS), séparées par des virgules. Laisser vide = liste par défaut.
# ALLOWED_ORIGINS=https://infotram.tmaxmls.ovh
